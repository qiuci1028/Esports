# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=esports
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_PASSWORD_HERE

# ===== Server =====
SERVER_PORT=8080

# ===== JWT =====
# 32 位以上随机字符串，生产用 openssl rand -base64 32 生成
JWT_SECRET=PLEASE_REPLACE_WITH_RANDOM_32_CHARS_OR_MORE_SECRET
JWT_EXPIRE_HOURS=72

# ===== Riot API =====
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxxxxxx
